---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Schema from '../components/Schema.astro';
import { isDemo } from '../lib/site';
import { clinica } from '../data/clinica';
import font from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; schema?: boolean }
const { title, description, schema = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f9f8" />
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} />
    {schema && <Schema />}
  </head>
  <body class="min-h-dvh">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-tinta focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    {isDemo && (
      <aside aria-label="Aviso de propuesta" class="relative z-50 bg-tinta text-blanc/80">
        <p class="label mx-auto flex max-w-[88rem] flex-wrap items-center justify-center gap-x-3 px-4 py-2 text-center text-[0.68rem]"><span>Propuesta de diseño no oficial</span><span aria-hidden="true">·</span><span class="hidden sm:inline">Preparada por Web Local Growth para {clinica.name}</span><span class="sm:hidden">Web Local Growth</span></p>
      </aside>
    )}
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
