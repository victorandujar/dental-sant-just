---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; heading: string }
const { title, heading } = Astro.props;
---
<Base title={title} description={`${heading} · Dental Clinic Sant Just`}>
  <Header />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-20 sm:px-8">
    <h1 class="serif text-[clamp(2.6rem,6vw,4rem)]">{heading}</h1>
    <div class="mt-10 space-y-5 text-lg leading-relaxed [&_h2]:serif [&_h2]:mt-10 [&_h2]:text-3xl [&_mark]:bg-guix [&_mark]:px-1"><slot /></div>
  </main>
  <Footer />
</Base>
