---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Guia from '../components/Guia.astro';
import Doctor from '../components/Doctor.astro';
import Tratamientos from '../components/Tratamientos.astro';
import Clinica from '../components/Clinica.astro';
import Visita from '../components/Visita.astro';
import Cinta from '../components/Cinta.astro';
import Cifras from '../components/Cifras.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---
<Base
  title="Dental Clinic Sant Just · Dentista en Sant Just Desvern desde 1990"
  description="Clínica dental en Sant Just Desvern (Carrer Marquès de Monistrol, 5). Dr. Carles Gargallo. Implantes, ortodoncia, estética dental, periodoncia y odontopediatría. Tel. 934 73 32 94."
  schema
>
  <Header />
  <main id="contenido">
    <Hero />
    <Cinta />
    <Cifras />
    <Guia />
    <Tratamientos />
    <Doctor />
    <Clinica />
    <Visita />
    <Contacto />
  </main>
  <Footer />
  <MobileBar />
</Base>
