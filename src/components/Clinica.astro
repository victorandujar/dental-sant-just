---
import { Image } from 'astro:assets';
import box from '../assets/clinica/box.jpg';
import passadis from '../assets/clinica/passadis.jpg';
import sala from '../assets/clinica/sala-espera.jpg';
import { clinica } from '../data/clinica';
---
<section id="clinica" aria-labelledby="clinica-t" class="bg-[#0b3442] text-white">
  <div class="mx-auto max-w-[88rem] px-4 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label text-[#8fd3e3]" data-reveal>La clínica</p>
        <h2 id="clinica-t" class="serif mt-4 text-[clamp(2.6rem,5.5vw,4.5rem)]" data-reveal style="--i:1">Las pruebas, aquí mismo.</h2>
      </div>
      <p class="text-lg text-white/75 lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">Cuatro boxes con radiología digital y otro para ortodoncia y cefalometrías. No tendrás que ir a otro centro a hacerte las pruebas.</p>
    </div>

    <div class="mt-14 grid auto-rows-[minmax(11rem,auto)] gap-4 md:grid-cols-6 lg:auto-rows-[13rem]">
      <figure class="group relative overflow-hidden rounded-[28px] md:col-span-4 md:row-span-2" data-reveal>
        <Image src={box} alt="Box dental con sillón blanco y un cuadro rojo en la pared" widths={[480, 650]} sizes="(min-width: 768px) 60vw, 92vw" class="h-full min-h-[18rem] w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-tinta backdrop-blur">Box de tratamiento</figcaption>
      </figure>
      <div class="flex flex-col justify-between rounded-[28px] bg-aigua p-7 md:col-span-2" data-reveal style="--i:1">
        <p class="text-6xl font-semibold tracking-[-0.05em]">{clinica.boxes}</p>
        <p class="text-lg leading-snug">boxes, todos con radiología digital</p>
      </div>
      <div class="flex flex-col justify-between rounded-[28px] bg-white p-7 text-tinta md:col-span-2" data-reveal style="--i:2">
        <svg viewBox="0 0 48 48" class="h-10 w-10 text-aigua" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="6" y="9" width="36" height="30" rx="5" /><path d="M14 31c3-8 6-12 10-12s7 4 10 12" /><path d="M6 17h36" /></svg>
        <p class="text-lg leading-snug">Box propio para ortodoncia y cefalometrías</p>
      </div>
      <figure class="group relative overflow-hidden rounded-[28px] md:col-span-3 md:row-span-2" data-reveal style="--i:1">
        <Image src={passadis} alt="Pasillo de la clínica con suelo de cristal sobre piedras blancas" widths={[480, 650]} sizes="(min-width: 768px) 45vw, 92vw" class="h-full min-h-[18rem] w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-tinta backdrop-blur">Suelo de cristal sobre cantos blancos</figcaption>
      </figure>
      <figure class="group relative overflow-hidden rounded-[28px] md:col-span-3 md:row-span-2" data-reveal style="--i:2">
        <Image src={sala} alt="Sala de espera con sillones y una planta" widths={[480, 650]} sizes="(min-width: 768px) 45vw, 92vw" class="h-full min-h-[18rem] w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-tinta backdrop-blur">Sala de espera</figcaption>
      </figure>
    </div>
  </div>
</section>
