---
import { tratamientos } from '../data/clinica';
---
<section id="tratamientos" aria-labelledby="trat-t" class="border-y border-linia bg-vidre">
  <div class="mx-auto grid max-w-[88rem] gap-12 px-4 py-20 sm:px-8 sm:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="trat-t" class="serif text-[clamp(2.6rem,5.5vw,4.5rem)]" data-reveal>Tratamientos</h2>
      <p class="mt-5 text-lg text-tinta-2" data-reveal style="--i:1">Todas las especialidades en la misma clínica, del primer diente de leche a los implantes.</p>
    </div>
    <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
      {tratamientos.map((t, i) => (
        <li class="group flex items-baseline gap-5 border-b border-linia py-4" data-reveal style={`--i:${i % 6}`}>
          <span class="label w-7 shrink-0 text-tinta-2 transition-colors group-hover:text-aigua">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-[1.4rem] font-medium leading-tight tracking-tight transition-transform duration-300 group-hover:translate-x-1">{t}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
