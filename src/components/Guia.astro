---
import Boca from './Boca.astro';
import { sintomas } from '../data/guia';
import { telUrl, clinica } from '../data/clinica';
---
<section id="que-notas" aria-labelledby="guia-t" class="bg-guix">
  <div class="mx-auto max-w-[88rem] px-4 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-6 lg:grid-cols-12">
      <h2 id="guia-t" class="serif text-[clamp(2.6rem,5.5vw,4.5rem)] lg:col-span-6" data-reveal>¿Qué notas?</h2>
      <p class="text-lg text-tinta-2 lg:col-span-5 lg:col-start-8 lg:pt-4" data-reveal style="--i:1">Elige lo que te pasa y te contamos qué especialidad lo trata en la clínica. Es solo una orientación: el diagnóstico lo hace siempre el dentista en la consulta.</p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-12" data-guia>
      <div role="radiogroup" aria-label="¿Qué notas?" class="grid content-start gap-2 lg:col-span-5" data-reveal style="--i:1">
        {sintomas.map((s) => (
          <button type="button" role="radio" aria-checked="false" data-sintoma={s.id} data-zona={s.zona} class="group flex items-center justify-between gap-4 border border-linia bg-blanc px-5 py-4 text-left text-[1.05rem] transition-colors hover:border-tinta aria-checked:border-vermell aria-checked:bg-white">
            <span>{s.pregunta}</span>
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full border border-linia text-xs text-transparent transition-colors group-aria-checked:border-vermell group-aria-checked:bg-vermell group-aria-checked:text-white" aria-hidden="true">✓</span>
          </button>
        ))}
      </div>

      <div class="lg:col-span-7" data-reveal style="--i:2">
        <div class="marc">
          <div class="bg-blanc px-4 pb-2 pt-6 sm:px-10"><Boca /></div>
        </div>
        <div class="mt-6 min-h-[11rem]" aria-live="polite">
          <p class="cartela" data-vacio>Selecciona una opción de la lista.</p>
          {sintomas.map((s) => (
            <div data-panel={s.id} hidden>
              <p class="label text-vermell">Lo trata</p>
              <p class="serif mt-2 text-[clamp(1.9rem,3vw,2.6rem)]">{s.especialidades.join(' · ')}</p>
              <p class="mt-3 max-w-xl text-tinta-2">{s.texto}</p>
              <div class="mt-5 flex flex-wrap gap-3">
                <a href={`#contacto`} data-motivo={s.pregunta} class="btn btn-vermell">Pedir cita para esto</a>
                <a href={telUrl} class="btn btn-line tabular-nums">Llamar · {clinica.phone.display}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-guia]')) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-sintoma]')];
    const boca = root.querySelector<SVGSVGElement>('[data-boca]');
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const vacio = root.querySelector<HTMLElement>('[data-vacio]');
    const select = (b: HTMLButtonElement, focus = false): void => {
      btns.forEach((x) => { x.setAttribute('aria-checked', String(x === b)); x.tabIndex = x === b ? 0 : -1; });
      boca?.setAttribute('data-zona', b.dataset.zona ?? '');
      panels.forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.sintoma));
      if (vacio) vacio.hidden = true;
      if (focus) b.focus();
    };
    btns.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b));
      b.addEventListener('keydown', (e) => {
        const d = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (d === undefined) return;
        e.preventDefault();
        select(btns[(i + d + btns.length) % btns.length]!, true);
      });
    });
    // "Pedir cita para esto" deixa el motiu escrit al formulari de contacte
    root.querySelectorAll<HTMLAnchorElement>('[data-motivo]').forEach((a) =>
      a.addEventListener('click', () => {
        const m = document.querySelector<HTMLTextAreaElement>('#motivo');
        if (m) m.value = a.dataset.motivo ?? '';
      }),
    );
  }
</script>
