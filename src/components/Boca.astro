---
/**
 * Dibuix frontal d'una dentadura (línia). Cada dent porta data-tipus i les zones
 * s'il·luminen segons l'atribut data-zona del <svg> (veure Guia.astro).
 */
const widths = [22, 24, 26, 27, 29, 33, 33, 29, 27, 26, 24, 22];
const heightsUp = [34, 38, 42, 46, 48, 52, 52, 48, 46, 42, 38, 34];
const heightsLo = [30, 34, 38, 40, 42, 44, 44, 42, 40, 38, 34, 30];
const tipus = (i: number): string => (i <= 2 || i >= 9 ? 'molar' : i === 3 || i === 8 ? 'canino' : 'frontal');
const total = widths.reduce((a, b) => a + b, 0) + 11 * 3;
let x = (440 - total) / 2;
const dents = widths.map((w, i) => {
  const cx = x + w / 2;
  const d = Math.abs(cx - 220) / 220;
  const lift = d * d * 34;
  const item = { i, x, w, hu: heightsUp[i]!, hl: heightsLo[i]!, lift, t: tipus(i) };
  x += w + 3;
  return item;
});
const r = 7;
const liftAt = (px: number): number => { const d = Math.abs(px - 220) / 220; return d * d * 34; };
const x0 = dents[0]!.x - 8;
const x1 = dents[dents.length - 1]!.x + dents[dents.length - 1]!.w + 8;
const steps = Array.from({ length: 41 }, (_, k) => x0 + ((x1 - x0) * k) / 40);
// Geniva: banda que segueix la vora dels dents (superior i inferior)
const gumUp = `M${steps.map((px) => `${px.toFixed(1)} ${(104 - liftAt(px)).toFixed(1)}`).join(' L')} L${[...steps].reverse().map((px) => `${px.toFixed(1)} ${(84 - liftAt(px)).toFixed(1)}`).join(' L')} Z`;
const gumLo = `M${steps.map((px) => `${px.toFixed(1)} ${(198 + liftAt(px)).toFixed(1)}`).join(' L')} L${[...steps].reverse().map((px) => `${px.toFixed(1)} ${(218 + liftAt(px)).toFixed(1)}`).join(' L')} Z`;
---
<svg viewBox="0 0 440 300" class="boca w-full" role="img" aria-label="Dibujo de una dentadura; se resalta la zona relacionada con lo que eliges" data-boca data-zona="">
  <!-- Encías -->
  {dents.map((d) => (
    <g data-tipus={d.t} data-i={d.i}>
      <path class:list={['dent', d.i === 9 && 'dent-falta']} d={`M${d.x} ${98 - d.lift} h${d.w} v${d.hu - r} q0 ${r} -${r} ${r} h-${d.w - 2 * r} q-${r} 0 -${r} -${r} z`} />
      <path class="dent" d={`M${d.x} ${204 + d.lift} h${d.w} v-${d.hl - r} q0 -${r} -${r} -${r} h-${d.w - 2 * r} q-${r} 0 -${r} ${r} z`} />
    </g>
  ))}
  <path class="encia" d={gumUp} />
  <path class="encia" d={gumLo} />
  <text x="220" y="294" text-anchor="middle" class="nota">Ilustración orientativa</text>
</svg>

<style>
  .boca .encia { fill: #f3d6d1; stroke: #c99c95; stroke-width: 1.2; stroke-linejoin: round; transition: fill 400ms, stroke 400ms; }
  .boca .dent { fill: #fff; stroke: var(--color-tinta); stroke-width: 1.4; transition: fill 400ms, stroke 400ms, opacity 400ms; }
  .boca .nota { font: 600 9px var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; fill: var(--color-tinta-2); }
  .boca[data-zona='molar'] [data-tipus='molar'] .dent,
  .boca[data-zona='frontal'] [data-tipus='frontal'] .dent,
  .boca[data-zona='frontal'] [data-tipus='canino'] .dent { fill: #fbe3e0; stroke: var(--color-vermell); stroke-width: 2; }
  .boca[data-zona='encia'] .encia { fill: #f2b9b1; stroke: var(--color-vermell); stroke-width: 2; }
  .boca[data-zona='falta'] .dent-falta { fill: transparent; stroke: var(--color-vermell); stroke-width: 2; stroke-dasharray: 4 4; }
  .boca[data-zona='infantil'] .dent { stroke: var(--color-vermell); }
  .boca[data-zona]:not([data-zona='']) .dent { opacity: 0.55; }
  .boca[data-zona='molar'] [data-tipus='molar'] .dent,
  .boca[data-zona='frontal'] [data-tipus='frontal'] .dent,
  .boca[data-zona='frontal'] [data-tipus='canino'] .dent,
  .boca[data-zona='falta'] .dent-falta,
  .boca[data-zona='infantil'] .dent,
  .boca[data-zona='encia'] .dent { opacity: 1; }
</style>
