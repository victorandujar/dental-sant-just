---
import { Image } from 'astro:assets';
import sala from '../assets/clinica/sala-espera.jpg';
import { clinica, telUrl } from '../data/clinica';
---
<section aria-labelledby="hero-t" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-[88rem] items-center gap-14 px-4 pb-24 pt-14 sm:px-8 md:pb-20 lg:grid-cols-12 lg:pt-20">
    <div class="lg:col-span-6">
      <p class="label text-vermell" data-reveal>Sant Just Desvern · desde {clinica.since}</p>
      <h1 id="hero-t" class="serif mt-6 text-[clamp(3.2rem,7.5vw,6.8rem)]" data-reveal style="--i:1">
        Tu dentista en Sant Just, <em class="text-vermell">desde hace más de 35 años.</em>
      </h1>
      <p class="mt-7 max-w-lg text-lg text-tinta-2" data-reveal style="--i:2">
        Una clínica en la calle Marquès de Monistrol, con cuatro boxes con radiología digital y las pruebas que necesites hechas aquí mismo, sin ir a otro centro.
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--i:3">
        <a href="#contacto" class="btn btn-vermell">Pedir cita</a>
        <a href={telUrl} class="btn btn-line tabular-nums">{clinica.phone.display}</a>
      </div>
    </div>

    <figure class="relative lg:col-span-6">
      <!-- El quadre vermell de la consulta, com a eco darrere de la foto -->
      <div class="absolute -right-4 -top-6 h-2/3 w-1/3 bg-vermell sm:-right-6 lg:-right-10" aria-hidden="true"></div>
      <div class="marc relative">
        <Image src={sala} alt="Sala de espera de la clínica: paredes blancas, sillones blancos y negros, una planta y luz natural" widths={[480, 650]} sizes="(min-width: 1024px) 44vw, 92vw" class="aspect-[4/3] w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
      <figcaption class="cartela mt-4 flex max-w-sm gap-3"><span class="mt-[0.45em] h-px w-6 shrink-0 bg-tinta-2"></span><span><strong class="font-semibold text-tinta">Sala de espera.</strong> Marquès de Monistrol, 5. Luz natural y líneas sencillas.</span></figcaption>
    </figure>
  </div>

  <dl class="mx-auto grid max-w-[88rem] grid-cols-2 border-y border-linia px-4 sm:px-8 lg:grid-cols-4" data-reveal>
    <div class="border-r border-linia py-6 pr-4"><dt class="label text-tinta-2">Abierta en</dt><dd class="serif mt-1 text-4xl">{clinica.since}</dd></div>
    <div class="py-6 pl-4 lg:border-r lg:border-linia lg:pr-4"><dt class="label text-tinta-2">Boxes con radiología digital</dt><dd class="serif mt-1 text-4xl">{clinica.boxes}</dd></div>
    <div class="border-r border-t border-linia py-6 pr-4 lg:border-t-0 lg:pl-4"><dt class="label text-tinta-2">Google</dt><dd class="serif mt-1 text-4xl">{clinica.google.rating} <span class="font-sans text-sm text-tinta-2">· {clinica.google.count} reseñas</span></dd></div>
    <div class="border-t border-linia py-6 pl-4 lg:border-t-0"><dt class="label text-tinta-2">Certificado</dt><dd class="serif mt-1 text-4xl">DentalQuality<span class="text-vermell">®</span></dd></div>
  </dl>
</section>
